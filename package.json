{
  "name": "KageJS",
  "version": "2.0.0",
  "description": "Ecosystem",
  "keywords": ["kagejs"],
  "author": "AvatarKage",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sandbox": "tsx sandbox/$npm_config_name.test.ts",
    "backup": "tsx dev/backup.ts",
    "build:utilities": "cd packages/utilities && tsx ../../dev/node/buildPackages.mts && cd ../../",
    "clean": "rimraf dist",
    "clean:post": "rimraf dist/dev && rimraf dist/sandbox && rimraf dist/packages && rimraf dist/vite.config.js",
    "sync": "tsx dev/syncConfig.ts",
    "minify": "npx esbuild \"dist/**/*.js\" --format=esm --minify --banner:js=\"/* This file is part of KageJS. Copyright (c) 2026 AvatarKage. Released under the MIT license. */\" --outdir=dist --allow-overwrite",
    "publish:utilities": "npm run build:utilities && cd packages/utilities && npm publish --access public && cd ../../"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@sapphire/stopwatch": "^1.5.4",
    "@tailwindcss/vite": "^4.3.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.0",
    "fast-glob": "^3.3.3",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.4.1",
    "http-proxy": "^1.18.1",
    "i18next": "^26.0.8",
    "i18next-http-backend": "^3.0.6",
    "kage-library": "^1.0.18",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "platform": "^1.3.6",
    "pm2": "^6.0.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.6",
    "react-live": "^5.0.1",
    "react-router-dom": "^7.14.2",
    "react-syntax-highlighter": "^16.1.2",
    "robots-parser": "^3.0.1",
    "systeminformation": "^5.33.15",
    "tailwindcss": "^4.3.0",
    "tldts": "^7.0.28",
    "translate": "^3.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cli-progress": "^3.11.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/http-proxy": "^1.17.17",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.2",
    "@types/platform": "^1.3.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cli-progress": "^3.12.0",
    "cpx": "^1.5.0",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "execa": "^9.6.1",
    "globals": "^17.4.0",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10"
  }
}
