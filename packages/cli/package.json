{
  "name": "@kagejs/cli",
  "version": "2.0.0",
  "description": "KageJS commands.",
  "keywords": [
    "kagejs",
    "typescript",
    "javascript",
    "cli",
    "commands",
    "build"
  ],
  "author": "AvatarKage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvatarKage/KageJS.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "kagejs": "./dist/index.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "sync": "tsx ../../dev/syncConfig.ts",
    "minify": "npx esbuild \"dist/**/*.js\" --format=esm --minify --banner:js=\"/* This file is part of KageJS. Copyright (c) 2026 AvatarKage. Released under the MIT license. */\" --outdir=dist --allow-overwrite"
  },
  "dependencies": {},
  "devDependencies": {}
}
