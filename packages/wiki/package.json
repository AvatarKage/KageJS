{
  "name": "@kagejs/wiki",
  "version": "2.0.0",
  "description": "A serverless Markdown powered wiki.",
  "keywords": [
    "kagejs",
    "typescript",
    "javascript",
    "wiki",
    "docs",
    "article"
  ],
  "author": "AvatarKage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvatarKage/KageJS.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "sync": "tsx ../../dev/syncConfig.ts",
    "minify": "npx esbuild \"dist/**/*.js\" --format=esm --minify --banner:js=\"/* This file is part of KageJS. Copyright (c) 2026 AvatarKage. Released under the MIT license. */\" --outdir=dist --allow-overwrite"
  },
  "dependencies": {
    "@kagejs/utilities": "2.6.1",
    "@kagejs/native": "2.0.1",
    "@kagejs/ui": "2.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {}
}
